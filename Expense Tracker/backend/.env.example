# Copy to .env and fill in real values. Never commit the completed file.

# MongoDB connection string.
# Local:
MONGO_URL=mongodb://localhost:27017/expense_tracker
# Atlas - replace <db_password> with your Atlas database user password.
# GOTCHA: drop the angle brackets too. They are Atlas's placeholder markers,
# not part of the string, and leaving them in fails as "bad auth" rather than
# a parse error, which sends you looking in the wrong place.
# The empty path before "/?" means the "test" database, which is where the
# records from the original internship build already live. Put a name there
# (e.g. /expense_tracker) only if you are happy starting from an empty database.
# MONGO_URL=mongodb+srv://abelink:<db_password>@expensetracker.luu9hse.mongodb.net/?retryWrites=true&w=majority&appName=expenseTracker

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-string

PORT=8000

# Origin allowed by CORS - the deployed frontend URL
CLIENT_URL=http://localhost:5173
