# Copy to .env and fill in real values. Never commit the completed file.

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URL=mongodb://localhost:27017/expensia

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=replace-with-a-long-random-string

PORT=8000

# Origin allowed by CORS - the deployed frontend URL
CLIENT_URL=http://localhost:5173
